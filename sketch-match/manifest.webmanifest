{
  "name": "Sketch Match",
  "short_name": "Sketch Match",
  "description": "Drawing practice: copy a picture on paper, take a photo of your drawing, and get friendly feedback on how it matches.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
